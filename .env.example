# Copiar a .env y completar. El .env nunca se sube al repositorio.
FORMDATA_ENTORNO=desarrollo

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
FORMDATA_SECRET_KEY=

# Desarrollo (SQLite, por defecto si se deja vacío):
# FORMDATA_DATABASE_URI=sqlite:///var/formdata.sqlite3
# Producción (PostgreSQL):
# FORMDATA_DATABASE_URI=postgresql+psycopg://formdata:CLAVE@localhost:5432/formdata

# --- Asistente (etapa 5) ---
# Dejando FORMDATA_IA_PROVEEDOR vacío el asistente igual funciona, en «modo sin
# modelo»: enruta las preguntas por palabras clave a las mismas herramientas y
# devuelve datos igual de reales, solo que sin redacción. Para usar un modelo:
#   FORMDATA_IA_PROVEEDOR=anthropic
#   FORMDATA_IA_MODELO=claude-sonnet-4-5
FORMDATA_IA_HABILITADA=0
FORMDATA_IA_PROVEEDOR=
FORMDATA_IA_MODELO=
FORMDATA_IA_API_KEY=

# --- Despliegue con Docker Compose (etapa 6) ---
POSTGRES_DB=formdata
POSTGRES_USER=formdata
POSTGRES_PASSWORD=
PUERTO=8000
